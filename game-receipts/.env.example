# Copy to .env.local. Nothing here is required for local dev.

# Required in production: signs session cookies (generate with `openssl rand -hex 32`).
SESSION_SECRET=

# Public base URL used for share links / OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: local JSON store location (defaults to ./.data).
# GR_DATA_DIR=

# Optional AI structuring via Claude (paid API — off by default; rules engine is used otherwise).
# Server-side only — never prefix with NEXT_PUBLIC_.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
